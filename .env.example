# pkgwatch mail configuration — copy to .env and fill in
# Modes (first match wins): resend (RESEND_API_KEY) > smtp (SMTP_HOST) > console

# --- Resend (https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=pkgwatch <you@your-domain.com>

# --- SMTP ---
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=you@example.com
#SMTP_PASS=secret
